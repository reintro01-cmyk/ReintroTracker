# Supabase project the app connects to.
# Local dev: leave unset to use the dev project (fallback in src/lib/supabase.js).
# Production (Vercel): set BOTH to your PRODUCTION Supabase project so published users are
# separate from dev/test. If unset in prod, the app falls back to the dev project.
#
# Use the publishable / anon key ONLY (safe to expose, protected by RLS). Never the service_role key.
VITE_SUPABASE_URL=https://your-prod-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
